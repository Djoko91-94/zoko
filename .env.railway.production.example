# Zoko Pro - Railway production template
# Copy these values into Railway > Project > Variables

NODE_ENV=production
PORT=3000

# PostgreSQL connection from Railway Postgres plugin
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# If frontend and backend share the same Railway app URL, use that URL.
# If frontend is hosted elsewhere, put that domain instead.
ALLOWED_ORIGINS=https://your-app-domain.up.railway.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Optional (email reminders)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com
