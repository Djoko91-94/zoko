# Zoko Pro - Render production template
# Copy these values into Render > Service > Environment

NODE_ENV=production
PORT=3000

# PostgreSQL connection from Render Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# If frontend and backend are on the same Render service, use your public app URL.
# If frontend is hosted elsewhere, put that domain instead.
ALLOWED_ORIGINS=https://your-app-domain.onrender.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Optional (email reminders)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com
